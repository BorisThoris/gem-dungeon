{
    "name": "threejs-gem-dungeon-editor",
    "packageManager": "yarn@1.22.22",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "React Three Fiber dungeon exploration/editor project with Three.js, TypeScript, Zustand, physics, tooling, and Electron packaging.",
    "author": "Boris Bostandzhiev",
    "main": "electron/main.js",
    "homepage": "./",
    "scripts": {
        "start": "vite",
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "test": "vitest run",
        "test:dungeon": "vitest run src/dungeon-core",
        "test:dungeon:watch": "vitest src/dungeon-core",
        "test:dungeon:property": "vitest run src/dungeon-core/__tests__/properties.test.ts",
        "test:dungeon:sweep": "tsx scripts/dungeon-seed-sweep.ts --count 25 --output artifacts/dungeon-sweep.json",
        "test:dungeon:stress": "tsx scripts/dungeon-seed-sweep.ts --count 1000 --output artifacts/dungeon-stress.json",
        "analyze:dungeon": "tsx scripts/dungeon-expressive-range.ts --count 100 --output artifacts/dungeon-expressive-range.json",
        "benchmark:dungeon:techniques": "tsx scripts/dungeon-technique-benchmark.ts --count 3 --candidates 4 --output artifacts/dungeon-technique-benchmark.json",
        "test:browser:cdp": "node scripts/browser-cdp-smoke.mjs",
        "typecheck:dungeon": "tsc -p tsconfig.dungeon.json",
        "preview": "vite preview",
        "electron": "electron .",
        "electron-dev": "concurrently \"yarn dev\" \"wait-on http://localhost:5173 && electron .\"",
        "electron-pack": "yarn build && electron-builder",
        "electron-dist": "yarn build && electron-builder --publish=never",
        "generate-config": "node scripts/generate-config.js",
        "generate-assets": "node scripts/generate-assets.js",
        "scan-components": "yarn ts-node src/utils/componentScanner.ts",
        "generate-textures": "node scripts/generate-textures.js",
        "meta": "node scripts/generate-project-meta.mjs",
        "meta:check": "node scripts/generate-project-meta.mjs --check",
        "shots": "node scripts/capture-project-shots.mjs",
        "social": "node scripts/generate-social-preview.mjs",
        "social:check": "node scripts/generate-social-preview.mjs --check",
        "icons": "node scripts/generate-app-icons.mjs",
        "icons:check": "node scripts/generate-app-icons.mjs --check",
        "meta:refresh": "node scripts/refresh-project-meta.mjs"
    },
    "dependencies": {
        "@react-three/drei": "^10.7.6",
        "@react-three/fiber": "^9.3.0",
        "@react-three/rapier": "^2.1.0",
        "glob": "^11.0.3",
        "pure-rand": "^8.4.2",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "three": "^0.180.0",
        "zustand": "^5.0.8"
    },
    "devDependencies": {
        "@eslint/js": "^9.37.0",
        "@storybook/addon-essentials": "^8.6.14",
        "@storybook/addon-interactions": "^8.6.14",
        "@storybook/addon-links": "^8.6.14",
        "@storybook/addon-onboarding": "^8.6.14",
        "@storybook/blocks": "^8.6.14",
        "@storybook/react": "^8.6.14",
        "@storybook/react-vite": "^8.6.14",
        "@storybook/test": "^8.6.14",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "@types/three": "^0.180.0",
        "@vitejs/plugin-react": "^4.7.0",
        "concurrently": "^9.2.1",
        "electron": "^38.1.2",
        "electron-builder": "^26.0.12",
        "eslint": "^9.36.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "fast-check": "^4.9.0",
        "globals": "^16.4.0",
        "knip": "^5.64.1",
        "terser": "^5.44.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.20.6",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.44.0",
        "vite": "^5.4.20",
        "vite-plugin-eslint": "^1.8.1",
        "vite-plugin-eslint2": "^5.0.4",
        "vitest": "^3.2.4",
        "wait-on": "^9.0.1"
    },
    "build": {
        "appId": "com.threejs.gem.game",
        "productName": "ThreeJS Gem Game",
        "directories": {
            "output": "dist-electron"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "node_modules/**/*"
        ],
        "win": {
            "target": "nsis"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "mac": {
            "target": "dmg",
            "icon": "public/favicon.ico"
        },
        "linux": {
            "target": "AppImage",
            "icon": "public/favicon.ico"
        }
    }
}
